    "./lib/play": "./src/lib/play.ts",
    "./lib/posePlay": "./src/lib/posePlay.ts",
    "./lib/shared": "./src/lib/shared.ts",
    "./lib/synthetic": "./src/lib/synthetic.ts",
    "./lib/synthetic_body": "./src/lib/synthetic_body.ts",
    "./lib/synthetic_hand": "./src/lib/synthetic_hand.ts",
    "./lib/take": "./src/lib/take.ts",
    "./nodes/face_categorizer": "./src/nodes/face_categorizer.ts",
    "./nodes/pose_categorizer": "./src/nodes/pose_categorizer.ts",
    "./nodes/categorizer_chord": "./src/nodes/categorizer_chord.ts",
    "./lib/categorizerChord": "./src/lib/categorizerChord.ts",
