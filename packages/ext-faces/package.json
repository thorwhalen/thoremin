    "./app/posePlay": "./src/app/posePlay.ts",
    "./app/sessionStore": "./src/app/sessionStore.ts",
    "./app/sharedModels": "./src/app/sharedModels.ts",
    "./app/sources": "./src/app/sources.ts",
    "./app/testStore": "./src/app/testStore.ts",
    "./app/thumbnails": "./src/app/thumbnails.ts",
    "./app/bodyModality": "./src/app/bodyModality.ts",
    "./app/bodySession": "./src/app/bodySession.ts",
    "./app/handModality": "./src/app/handModality.ts",
    "./app/handSession": "./src/app/handSession.ts",
    "./app/modality": "./src/app/modality.ts",
    "./branches": "./src/branches.ts",
    "./dials": "./src/dials.ts",
    "./lazy": "./src/lazy.ts",
    "./lazy_ui": "./src/lazy_ui.tsx",
