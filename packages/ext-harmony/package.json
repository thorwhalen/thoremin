    "./app/micChordIn": "./src/app/micChordIn.ts",
    "./app/midiChordIn": "./src/app/midiChordIn.ts",
    "./branches": "./src/branches.ts",
    "./dials": "./src/dials.ts",
    "./id": "./src/id.ts",
    "./lib/audio_heard": "./src/lib/audio_heard.ts",
    "./lib/chord_chart": "./src/lib/chord_chart.ts",
    "./lib/chord_map": "./src/lib/chord_map.ts",
    "./lib/midi_held": "./src/lib/midi_held.ts",
    "./nodes/chord_chart": "./src/nodes/chord_chart.ts",
