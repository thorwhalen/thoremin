{
  "name": "@thoremin/games",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "thoremin's listening games, pure: lessons as data, the Sing, Play along and Match the note sessions and the calibration take, and the field games (Pop the Notes, the Pitch Maze) built from a voice cursor, a loudness scale and a dwell; each session is fed what was heard each tick and returns a view model plus the sounds to play, and two stages draw the views on a 2D canvas (TypeScript source, consumed through the workspace).",
  "exports": {
    ".": "./src/index.ts",
    "./calibrate": "./src/calibrate.ts",
    "./cues": "./src/cues.ts",
    "./cursor": "./src/cursor.ts",
    "./difficulty": "./src/difficulty.ts",
    "./dwell": "./src/dwell.ts",
    "./field": "./src/field.ts",
    "./field_stage": "./src/field_stage.ts",
    "./lesson": "./src/lesson.ts",
    "./lesson_schema": "./src/lesson_schema.ts",
    "./lessons": "./src/lessons.ts",
    "./listen": "./src/listen.ts",
    "./loudness": "./src/loudness.ts",
    "./match": "./src/match.ts",
    "./maze": "./src/maze.ts",
    "./play_along": "./src/play_along.ts",
    "./pop": "./src/pop.ts",
    "./sing": "./src/sing.ts",
    "./stage": "./src/stage.ts",
    "./view": "./src/view.ts",
    "./vowels": "./src/vowels.ts",
    "./echo": "./src/echo.ts",
    "./echo_stage": "./src/echo_stage.ts",
    "./spec": "./src/spec.ts",
    "./spec_schema": "./src/spec_schema.ts"
  },
  "dependencies": {
    "@thoremin/judge": "*",
    "@thoremin/sdk": "*",
    "@thoremin/stats": "*",
    "zod": "*"
  }
}
