{
  "name": "thoremin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "check:lazy": "vite-node scripts/check_lazy_bundle.ts",
    "check:play": "vite-node scripts/check_play_bundle.ts",
    "build:funfon": "vite build --config vite.funfon.config.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --testTimeout=60000 --coverage --coverage.provider=v8 --coverage.reportOnFailure --coverage.include='packages/*/src/**' --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.reporter=html",
    "typecheck": "tsc -p tsconfig.dag.json --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit",
    "typecheck:react": "tsx scripts/react_type_ratchet.ts",
    "typecheck:react:baseline": "tsx scripts/react_type_ratchet.ts --update",
    "ratchet:arch": "vite-node scripts/architecture_ratchet.ts",
    "stability": "vite-node scripts/stability/baseline.ts",
    "test:lab": "THOREMIN_EXTENSIONS=extensions.lab.json vitest run test/games test/instruments/extensions.test.ts test/app_graph.test.ts test/library_category.test.ts test/air_instruments_view.test.tsx test/instruments_view_search.test.tsx",
    "test:core": "npm run typecheck:core && THOREMIN_EXTENSIONS=extensions.core.json vitest run && vite-node scripts/check_core_bundle.ts",
    "record": "vite-node scripts/record_stream.ts",
    "pair": "vite-node scripts/cue/pair_take.ts",
    "catalog": "vite-node scripts/gen_catalog.ts",
    "guide": "vite-node scripts/gen_guide.ts",
    "guide:check": "vite-node scripts/gen_guide.ts --check",
    "guide:media": "node smoke/guide_media.mjs",
    "faces:demo": "vite-node scripts/faces/build_demo_categorizer.ts",
    "extensions": "vite-node scripts/gen_extensions.ts",
    "voice": "vite-node scripts/cue_strings.ts | python3 scripts/gen_cue_voice.py",
    "check:models": "tsx scripts/check_models.ts",
    "smoke": "npm run smoke:setup && npm run smoke:run",
    "smoke:setup": "npm --prefix smoke ci --no-audit --no-fund && npx --prefix smoke playwright install chromium",
    "smoke:run": "npx --prefix smoke playwright test -c smoke/playwright.config.ts",
    "research-guide": "vite-node scripts/research_guide/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.12",
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@google/genai": "^1.29.0",
    "@jsep-plugin/ternary": "^1.1.4",
    "@mediapipe/tasks-vision": "1.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@thoremin/ext-asl": "github:thorwhalen/thoremin-asl#d2b5a897540269e9902da8c696c3c930faa38c08",
    "@thoremin/ext-draw": "github:thorwhalen/thoremin-ar#e18581316f915be91eb35b0496269c590f31fe83",
    "@tonejs/midi": "^2.0.28",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@zodal/core": "^0.1.2",
    "@zodal/dials-core": "^0.1.0",
    "@zodal/dials-ui": "^0.1.0",
    "@zodal/groups-core": "^0.1.0",
    "@zodal/store": "^0.1.2",
    "@zodal/store-localstorage": "^0.1.0",
    "@zodal/ui": "^0.1.2",
    "acture": "^1.3.0",
    "acture-ai-vercel": "^2.0.0",
    "acture-forms-autoform": "^1.0.1",
    "acture-palette-react": "^1.0.0",
    "ai": "^7.0.22",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "jsep": "^1.4.0",
    "libflacjs": "^5.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "musicxml-io": "^0.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "signalsmith-stretch": "1.3.2",
    "spessasynth_core": "4.3.22",
    "spessasynth_lib": "4.3.14",
    "three": "^0.186.1",
    "tinykeys": "^4.0.0",
    "tonal": "^6.4.0",
    "umap-js": "^1.4.0",
    "vite": "^6.2.0",
    "webmidi": "^3.1.16",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "3.2.6",
    "jsdom": "^27.0.1",
    "marked": "18.0.14",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "zod": "$zod"
  },
  "workspaces": [
    "packages/*"
  ]
}
